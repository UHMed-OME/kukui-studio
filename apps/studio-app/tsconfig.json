{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["dist", "**/*.test.tsx", "**/*.test.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/schemas" }
  ]
}
