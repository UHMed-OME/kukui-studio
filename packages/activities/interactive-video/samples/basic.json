{
  "version": "1.0",
  "title": "🎬 Big Buck Bunny — checkpoints",
  "prompt": "<p>Watch the clip; an info card and two questions appear on the timeline.</p>",
  "video": {
    "src": "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
    "type": "html5",
    "poster": "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/images/BigBuckBunny.jpg"
  },
  "interactions": [
    {
      "id": "iv-note",
      "atSeconds": 2,
      "required": false,
      "kind": "label",
      "title": "Before you watch",
      "config": {
        "html": "<p>Notice the colour palette of the opening landscape — you'll be asked about it.</p>"
      }
    },
    {
      "id": "iv-q1",
      "atSeconds": 5,
      "required": true,
      "title": "Opening shot",
      "kind": "multipleChoice",
      "config": {
        "version": "1.0",
        "title": "Opening shot",
        "question": "<p>What is the dominant color of the opening landscape?</p>",
        "answers": [
          { "text": "Green meadow", "correct": true, "feedback": "Yes — soft pastel green dominates." },
          { "text": "Red desert", "correct": false, "feedback": "Look again — the palette is cooler." },
          { "text": "Snowy peaks", "correct": false }
        ]
      }
    },
    {
      "id": "iv-q2",
      "atSeconds": 12,
      "required": true,
      "title": "Name the character",
      "kind": "fillInTheBlanks",
      "config": {
        "version": "1.0",
        "title": "Naming the character",
        "text": "The protagonist of this short is a *rabbit/bunny*."
      }
    }
  ],
  "behaviour": {
    "enableRetry": false,
    "passPercentage": 50
  },
  "ui": {
    "resumeButtonLabel": "Resume video"
  }
}
