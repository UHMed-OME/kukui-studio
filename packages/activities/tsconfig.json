{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "*/**/*.ts", "*/**/*.tsx"],
  "exclude": ["dist", "**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "../schemas" }
  ]
}
